%\renewcommand{\lstlistingname}{Algoritmo}
\lstdefinestyle{arduinostyle}{
    language=C,                            % Arduino code is similar to C/C++
    basicstyle=\ttfamily\footnotesize,     % Basic font style
    keywordstyle=\color{black},            % Keyword color
    commentstyle=\color{black},            % Comment color
    stringstyle=\color{black},             % String color
    numbers=left,                          % Line numbers on the left
    numberstyle=\bfseries\tiny\color{black}, % Larger and bolder line number font
    stepnumber=1,                          % Line number step
    numbersep=5pt,                         % Distance between line numbers and code
    backgroundcolor=\color{white},         % Background color
    showspaces=false,                      % Do not show spaces
    showstringspaces=false,                % Do not underline spaces in strings
    frame=single,                          % Add a frame around the code
    rulecolor=\color{black},               % Frame color
    breaklines=true,                       % Automatic line breaking
    breakatwhitespace=false,               % Break lines only at whitespace
    tabsize=4,                             % Size of tab
    captionpos=b                           % Caption position at bottom
}



